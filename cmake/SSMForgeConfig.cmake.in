@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find CUDA Toolkit dependency (provides CUDA::cufft and CUDA::cudart)
find_dependency(CUDAToolkit REQUIRED)

# Find Eigen3 dependency (provides Eigen3::Eigen)
if(NOT TARGET Eigen3::Eigen)
    find_package(Eigen3 3.3 QUIET CONFIG)
    if(NOT TARGET Eigen3::Eigen)
        # Search for Eigen headers directly if config was not found
        find_path(EIGEN3_INCLUDE_DIR NAMES Eigen/Dense
            PATHS
                ${EIGEN3_ROOT}
                $ENV{EIGEN3_ROOT}
                ${Eigen3_DIR}
                $ENV{Eigen3_DIR}
                ${CMAKE_PREFIX_PATH}
            PATH_SUFFIXES include/eigen3 eigen3 include
        )
        if(EIGEN3_INCLUDE_DIR)
            add_library(Eigen3::Eigen INTERFACE IMPORTED)
            set_target_properties(Eigen3::Eigen PROPERTIES
                INTERFACE_INCLUDE_DIRECTORIES "${EIGEN3_INCLUDE_DIR}"
            )
            set(Eigen3_FOUND TRUE)
        else()
            message(FATAL_ERROR "SSMForge requires Eigen3. Please install Eigen3 or specify -DEigen3_DIR=<path> or -DEIGEN3_ROOT=<path> or include Eigen in CMAKE_PREFIX_PATH.")
        endif()
    endif()
endif()

# Include the auto-generated exported targets
include("${CMAKE_CURRENT_LIST_DIR}/SSMForgeTargets.cmake")

check_required_components(SSMForge)
